PORT=8080
NODE_ENV=development
LOG_LEVEL=info
MAX_UPLOAD_MB=15

# Set CLOCKED_MODE=mock to run without Clocked credentials.
CLOCKED_MODE=mock
CLOCKED_API_BASE_URL=https://clocked.rezolve.ai
CLOCKED_API_KEY=
CLOCKED_TIMEOUT_MS=60000
CLOCKED_RETRIES=2
CLOCKED_FAIL_CLOSED=true

# Set CLOCKED_DEBUG=true to enable detailed console logging of pipeline
# requests/responses. Raw EDI text and API credentials are never logged.
CLOCKED_DEBUG=false

# Verify these paths against your Clocked workspace/API documentation.
CLOCKED_EXTRACT_PATH=/clocked/extract
CLOCKED_DECIDE_PATH=/clocked/decide
CLOCKED_PII_PATH=/clocked/pii
CLOCKED_INJECTION_PATH=/clocked/injection
